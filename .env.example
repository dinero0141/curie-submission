# Copy to .env and fill in. Never commit .env.

# Local services from `docker compose up -d postgres redis` (non-default host ports).
# The local Postgres user/password are throwaway dev values defined in docker-compose.yml.
DATABASE_URL=postgres://curie:curie@localhost:54329/curie
REDIS_URL=redis://localhost:63799

# Model provider: `anthropic` (real Claude) or `fake` (scripted, offline demo/tests).
MODEL_PROVIDER=anthropic
# Required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limits (defaults shown).
MAX_DOCUMENT_BYTES=5242880
FULL_CONTEXT_TOKENS=60000
PASSAGE_TOKENS=400
MAX_ANSWER_TOKENS=1024
MODEL_TIMEOUT_MS=90000

PORT=3000
